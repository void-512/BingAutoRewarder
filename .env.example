# Shell-compatible settings, read only by run.sh. Relative paths are repo-relative.
# Preserve these locations across upgrades: they contain account data and cookies.
AUTOREWARDER_DATA_DIR=./var
# Optional: separate existing profile storage (mounts its profiles/ directory).
# AUTOREWARDER_CHROMIUM_DATA_DIR=/absolute/path/to/chromium_data
AUTOREWARDER_REMOTE_URL=http://127.0.0.1:4444
AUTOREWARDER_REMOTE_PROFILE_ROOT=/home/seluser/profiles
TZ=America/Toronto
# Default image is pinned in deploy/compose.yaml. Override deliberately if needed.
# SELENIUM_IMAGE=selenium/standalone-chromium:4.51.0-20261010
# For non-default Compose projects (also creates isolated containers):
# COMPOSE_PROJECT_NAME=autorewarder-browser
# Optional noVNC password: exactly 8 characters. Otherwise prompted with --visible.
# SE_VNC_PASSWORD=REPLACE8
